<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#1a1a2e">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shell Command</title>
  <style>
    body { background: #1a1a2e; color: #eee; font-family: monospace; padding: 1em; overflow-x: hidden; }
    html { overflow-x: hidden; }
    .cmd-bar { display: flex; gap: 0.5em; align-items: center; margin-bottom: 0.5em; }
    .cmd-input { flex: 1; padding: 0.4em; font-size: 15px; border-radius: 4px; border: 1px solid #444; background: #16213e; color: #0f0; font-family: monospace; min-width: 0; }
    .output { width: 100%; min-height: 40vh; padding: 0.5em; background: #0a0a0a; border-radius: 4px; white-space: pre-wrap; word-break: break-all; overflow-wrap: break-word; font-size: 14px; box-sizing: border-box; }
    .btn { padding: 0.4em 1.2em; cursor: pointer; background: #0f3460; color: #eee; border: none; border-radius: 4px; white-space: nowrap; font-size: 14px; }
    .btn:hover { background: #16537e; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>
</head>
<body>
  <div class="cmd-bar">
    <input class="cmd-input" id="cmd" placeholder="输入命令，例如: ls" value="ls" autofocus>
    <button class="btn" id="runBtn" onclick="run()">执行</button>
    <button class="btn" onclick="clearOut()">清空</button>
  </div>
  <div class="output" id="output"></div>
  <script>
    const out = document.getElementById('output')
    const input = document.getElementById('cmd')
    const runBtn = document.getElementById('runBtn')
    let cmdRunning = false
    let currentCmdId = null   // 当前命令的唯一 ID

    // 页面加载时建立固定 SSE 通道
    const sseSid = 'shellcmd'
    const source = new EventSource('/sse/elecV2P/' + sseSid)
    source.onmessage = (e) => {
      try {
        const msg = JSON.parse(e.data)
        if (msg.type === 'shell') {
          if (msg.finish) {
            if (msg.id === currentCmdId) {
              // 命令结束：顶部显示完成消息
              const div = document.createElement('div')
              div.className = 'block finished'
              div.style.color = '#4fc3f7'
              div.textContent = '> ' + msg.cmd + ' —— 命令完成\n'
              out.insertBefore(div, out.firstChild)
              currentCmdId = null
            }
            cmdRunning = false
            runBtn.disabled = false
            runBtn.textContent = '执行'
          } else if (msg.data && msg.id === currentCmdId) {
            // 实时流式：每行 prepend 到顶部（最新输出在最上）
            const div = document.createElement('div')
            div.className = 'block live'
            div.textContent = msg.data
            out.insertBefore(div, out.firstChild)
          }
        }
      } catch (err) {
        console.error('SSE parse error', err)
      }
    }
    source.onerror = () => {
      console.error('SSE error, readyState:', source.readyState)
    }

    function run() {
      if (cmdRunning) return
      const cmd = input.value.trim() || 'ls'
      input.value = ''
      cmdRunning = true
      runBtn.disabled = true
      runBtn.textContent = '运行中...'

      // 发送命令到后端，后端通过固定 sid 的 SSE 通道流式推送输出
      currentCmdId = Date.now()
      $fend('run', { cmd, sid: sseSid, id: currentCmdId }).then(res => res.text()).then(data => {
        // $fend 本身返回占位，实际输出通过 SSE
        if (data && data.trim() && data.trim() !== 'no output') {
          console.log('$fend result:', data)
        }
      }).catch(e => {
        const div = document.createElement('div')
        div.className = 'block live'
        div.style.color = '#ff5252'
        div.textContent = '> ' + cmd + '\n错误: ' + e
        out.insertBefore(div, out.firstChild)
        cmdRunning = false
        runBtn.disabled = false
        runBtn.textContent = '执行'
      })
    }

    input.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault()
        run()
      }
    })

    function clearOut() {
      out.textContent = ''
    }
  </script>
</body>
</html>

<script favend runon="elecV2P">
  $fend('run', async data => {
    // data 格式: { cmd, sid, id }
    const { cmd, sid, id } = data
    let output = ''
    return new Promise((resolve) => {
      $exec(cmd, {
        from: 'eapp-shell',
        timeout: 30000,
        cb(data, error, finished) {
          if (error) {
            $ws.sse(sid, { type: 'shell', id, data: 'ERROR: ' + error + '\n' })
          } else if (data) {
            $ws.sse(sid, { type: 'shell', id, data: data + '\n' })
          }
          if (finished === true) {
            // 结束时不重复完整输出，只推完成信号
            $ws.sse(sid, { type: 'shell', id, cmd, finish: true })
            resolve(output || 'no output')
          }
        }
      })
    })
  })
</script>